
#include <iostream>
using namespace std;

int main()
{
    int age;

    cout << "Enter your age: ";
    cin >> age;

    try
    {
        if (age < 0 && age>125)
        {
            throw age;
        }

        cout << "Valid age: " << age << endl;
    }
    catch (int x)
    {
        cout << "Exception caught: Invalid age!" << endl;
    }

    return 0;
}
